<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: ocean blue with a lighter crown, so the mark
     keeps a little depth under a circular mask. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#3FA9D6"
        android:centerColor="#0077B6"
        android:endColor="#005A8C"
        android:type="linear" />
</shape>
